Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  # Stable URLs must check for updates; unchanged responses can use HTTP 304.
  Header set Cache-Control "public, max-age=0, must-revalidate"
  <FilesMatch "(^sw\.js$|\.html$|\.webmanifest$)">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Vite gives built assets a new filename whenever their contents change.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|json)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
